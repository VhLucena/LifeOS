<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.lifeos.granola-sync</string>
<key>ProgramArguments</key><array>
<string>__HOME__/.venvs/lifeos/bin/python</string>
<string>__LIFEOS_PATH__/scripts/sync_granola.py</string>
</array>
<key>WorkingDirectory</key><string>__LIFEOS_PATH__</string>
<key>StartInterval</key><integer>3600</integer>
<key>RunAtLoad</key><true/>
<key>ProcessType</key><string>Background</string>
<key>StandardOutPath</key><string>__LIFEOS_PATH__/data/granola-sync/sync.log</string>
<key>StandardErrorPath</key><string>__LIFEOS_PATH__/data/granola-sync/sync.log</string>
</dict></plist>
